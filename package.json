{
  "name": "nhi-lifecycle-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite --port 5173",
    "server": "node dist/server.js",
    "start": "npm run build && node dist/server.js",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "bench": "npm run build:core && node dist/bench.js",
    "build:core": "tsc -p tsconfig.json",
    "seed": "npm run build:core && node dist/cli.js seed"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
